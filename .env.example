# ==========================================================
#  NAKRUTKA BLOCKER BOT  —  sozlamalar
#  Bu faylni ".env" nomi bilan nusxalab, qiymatlarni to'ldiring
# ==========================================================

# @BotFather dan olingan token (MAJBURIY)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Botni boshqaradigan adminlar ID raqamlari (vergul bilan)
# O'z ID'ingizni bilish uchun: @userinfobot ga /start yuboring
ADMIN_IDS=123456789

# Log kanal/guruh ID (bot bloklaganlarni shu yerga yozadi)
# Bot shu kanalda ham admin bo'lishi kerak. Bo'sh qoldirsangiz
# loglar ADMIN_IDS ga shaxsiy xabar sifatida yuboriladi.
LOG_CHAT_ID=

# ---------------- Himoya sozlamalari ----------------------
# Rejim: ban | kick | mute | report
#   ban    - butunlay bloklaydi (qayta kira olmaydi)   <-- tavsiya
#   kick   - chiqaradi, lekin qayta kirishi mumkin
#   mute   - guruhda ovozini o'chiradi
#   report - hech kimni o'chirmaydi, faqat logga yozadi (test uchun)
MODE=ban

# Necha balldan boshlab nakrutka deb hisoblanadi (0-100).
# 50 - muvozanatli, 40 - qattiq, 65 - yumshoq
SCORE_THRESHOLD=50

# QATTIQ QOIDALAR — ball yetmasa ham darhol bloklaydi.
#   0 = o'chiq (faqat ball tizimi)
#   1 = rasm ham, username ham yo'q bo'lsa  <-- ko'pchilik uchun eng yaxshi
#   2 = profil rasmi yo'q bo'lsa
#   3 = username yo'q YOKI akkaunt yangi bo'lsa (eng qattiq, xato bloklash ko'payadi)
# Premium akkauntlar bu qoidalardan ozod.
STRICT_LEVEL=0

# Telegram ID shu raqamdan katta bo'lsa — "juda yangi akkaunt".
# Nakrutka servislar odatda yangi akkauntlar ishlatadi.
# 2026-yil uchun ~8.2 mlrd. /calibrate buyrug'i bilan aniqlashtirish mumkin.
NEW_ACCOUNT_ID=8200000000
VERY_NEW_ACCOUNT_ID=8600000000
OLD_ACCOUNT_ID=1500000000

# ---------------- Guruh/to'da (burst) himoyasi -------------
# BURST_WINDOW sekund ichida BURST_LIMIT dan ko'p odam kirsa,
# bu nakrutka to'lqini deb hisoblanadi va hammaga qo'shimcha ball qo'yiladi.
BURST_WINDOW=60
BURST_LIMIT=8

# Nakrutka to'lqini aniqlanganda taklif havolasini avtomatik
# yangilash (eski havola ishlamay qoladi). 1 = yoqilgan
AUTO_ROTATE_LINK=0

# Premium akkauntlarni hech qachon bloklamaslik (1 = ha)
PROTECT_PREMIUM=0

# Ma'lumotlar bazasi fayli
DB_PATH=nakrutka.db

# ==========================================================
#  WEB APP (Telegram Mini App)
#  Web ilovaning HTTPS manzili (Cloudflare Tunnel, ngrok yoki domen).
#  Bo'sh bo'lsa Mini App Telegram menyusiga chiqmaydi, lekin lokal server ishlaydi.
#  Masalan: https://nakrutka-app.trycloudflare.com
# ==========================================================
WEBAPP_URL=
WEBAPP_PORT=8080

# ==========================================================
#  ESKI A'ZOLARNI TEKSHIRISH (/scan buyrug'i va scanner.py)
#  Telegram a'zolar ro'yxatini botga bermaydi — faqat odamga beradi.
#  Shuning uchun bu yerga o'z akkauntingiz kaliti yoziladi:
#  https://my.telegram.org -> API development tools
#  Keyin BIR MARTA login.bat ni ishga tushiring.
#  Bo'sh qoldirsangiz bot ishlaydi, lekin /scan ishlamaydi.
# ==========================================================
API_ID=
API_HASH=
SESSION_NAME=scanner

# /scan SIZNING akkauntingiz orqali o'qiydi, shuning uchun uni boshqalarga
# bermaslik xavfsizroq. 1 = faqat ADMIN_IDS, 0 = kanal adminlari ham (xizmat).
SCAN_ONLY_OWNER=1

# Skaner akkaunti kanalga a'zo bo'lmasa, bot taklif havolasi yaratib akkaunt
# o'zi qo'shilsinmi? 1 = ha. DIQQAT: bitta akkaunt kuniga ~20-50 dan ortiq
# kanalga qo'shilsa Telegram vaqtincha yoki butunlay cheklaydi.
AUTO_JOIN=1

# Eski a'zolarni avtomatik tekshirish: 0 = o'chiq, 24 = kunda bir marta
AUTO_SCAN_HOURS=0
# 1 = topilganlarni so'ramasdan bloklaydi, 0 = avval sizdan tasdiq so'raydi
AUTO_SCAN_APPLY=0
